#!/bin/bash
# Wrapper script for Food Tracker CLI
# Usage: ./food-tracker [command] [args...]

# Check if docker compose is available
if ! command -v docker &> /dev/null; then
    echo "Error: docker command not found."
    exit 1
fi

# Run the command inside the container
# We use -T to disable pseudo-tty allocation if needed, but for interactive use we usually want it.
# However, for agents/scripts, strictly speaking we might not need a TTY.
# Let's keep it simple: exec passing all args.
docker compose --env-file .env -f deploy/compose.yml exec food-tracker python -m cli.main "$@"
